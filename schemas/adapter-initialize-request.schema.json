{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://interlock.dev/schemas/adapter-initialize-request.schema.json",
  "title": "Interlock adapter.initialize request",
  "type": "object",
  "additionalProperties": false,
  "required": ["jsonrpc", "id", "method", "params"],
  "properties": {
    "jsonrpc": { "const": "2.0" },
    "id": { "type": "string", "minLength": 1 },
    "method": { "const": "adapter.initialize" },
    "params": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol_version", "core_version", "adapter_kind"],
      "properties": {
        "protocol_version": { "type": "string", "pattern": "^1\\.[0-9]+$" },
        "core_version": { "type": "string", "minLength": 1 },
        "adapter_kind": { "enum": ["tracker", "harness", "workspace", "environment"] },
        "workspace": { "type": "string" }
      }
    }
  }
}
