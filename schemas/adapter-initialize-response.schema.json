{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://interlock.dev/schemas/adapter-initialize-response.schema.json",
  "title": "Interlock adapter.initialize response",
  "type": "object",
  "additionalProperties": false,
  "required": ["jsonrpc", "id", "result"],
  "properties": {
    "jsonrpc": { "const": "2.0" },
    "id": { "type": "string", "minLength": 1 },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapter"],
      "properties": {
        "adapter": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "version", "protocol_versions", "capabilities"],
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "version": { "type": "string", "minLength": 1 },
            "protocol_versions": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string" }
            },
            "capabilities": {
              "type": "object",
              "additionalProperties": { "type": "boolean" }
            }
          }
        }
      }
    }
  }
}
