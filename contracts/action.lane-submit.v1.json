{
  "input": {
    "type": "object",
    "properties": {
      "lane": {
        "type": "string",
        "description": "Recorded lane reference.",
        "metavar": "LANE",
        "positional": true
      },
      "artifact": {
        "type": "string",
        "description": "Artifact URL, for example the pull request.",
        "metavar": "ARTIFACT"
      },
      "head": {
        "type": "string",
        "description": "Head commit the evidence covers.",
        "metavar": "HEAD"
      },
      "gate": {
        "type": "string",
        "description": "Evidence gate name.",
        "metavar": "GATE"
      },
      "evidence-url": {
        "type": "string",
        "description": "Evidence URL for the gate at the head commit.",
        "metavar": "URL"
      },
      "state": {
        "type": "string",
        "description": "Local execution database path.",
        "metavar": "PATH"
      }
    },
    "required": [
      "lane",
      "artifact",
      "head",
      "gate",
      "evidence-url"
    ],
    "additionalProperties": false
  },
  "output": {
    "oneOf": [
      {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean",
            "const": true
          },
          "value": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "ticket": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "run": {
                "type": "string"
              },
              "claim": {
                "type": "string"
              },
              "state": {
                "type": "string",
                "enum": [
                  "queued",
                  "claimed",
                  "implementing",
                  "submitted",
                  "reviewing",
                  "approved",
                  "merged",
                  "done",
                  "attention"
                ]
              },
              "previousState": {
                "type": "string",
                "enum": [
                  "queued",
                  "claimed",
                  "implementing",
                  "submitted",
                  "reviewing",
                  "approved",
                  "merged",
                  "done",
                  "attention"
                ]
              },
              "attentionReason": {
                "type": "string"
              },
              "artifact": {
                "type": "string"
              },
              "head": {
                "type": "string"
              },
              "evidence": {
                "readOnly": true,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "gate": {
                      "type": "string"
                    },
                    "head": {
                      "type": "string"
                    },
                    "url": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "gate",
                    "head",
                    "url"
                  ],
                  "additionalProperties": false
                }
              },
              "verdict": {
                "type": "object",
                "properties": {
                  "head": {
                    "type": "string"
                  },
                  "decision": {
                    "type": "string",
                    "enum": [
                      "approved",
                      "changes_requested"
                    ]
                  },
                  "findings": {
                    "readOnly": true,
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "round": {
                    "type": "number"
                  }
                },
                "required": [
                  "head",
                  "decision",
                  "findings",
                  "round"
                ],
                "additionalProperties": false
              },
              "reviewRound": {
                "type": "number"
              },
              "maxReviewRounds": {
                "type": "number"
              },
              "createdAt": {
                "type": "string"
              },
              "updatedAt": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "state",
              "evidence",
              "reviewRound",
              "maxReviewRounds",
              "createdAt",
              "updatedAt"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "ok",
          "value"
        ],
        "additionalProperties": false
      },
      {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean",
            "const": false
          },
          "refusal": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "claim_collision",
                  "stale_version",
                  "unsupported_capability",
                  "ambiguous_write",
                  "invalid_transition",
                  "stale_evidence",
                  "recovery_required",
                  "gates_unmet",
                  "artifact_required",
                  "artifact_mismatch",
                  "tracker_not_done",
                  "lane_not_found"
                ]
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "code",
              "message"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "ok",
          "refusal"
        ],
        "additionalProperties": false
      }
    ]
  }
}
