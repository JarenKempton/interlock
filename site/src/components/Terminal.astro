---
interface Props {
  command: string;
  output: string;
  caption: string;
}

const { command, output, caption } = Astro.props;
const lines = output.replace(/\n+$/, "").split("\n");
const tone = (line: string) =>
  line.startsWith("✗") ? "bad" : line.startsWith("✓") ? "good" : undefined;
---

<figure class="terminal">
  <figcaption>{caption}</figcaption>
  <pre tabindex="0"><code><span class="prompt" aria-hidden="true">$ </span><span class="cmd">{command}</span>
{lines.map((line) => <span class={tone(line)}>{line}{"\n"}</span>)}</code></pre>
</figure>

<style>
  .terminal {
    margin: 0;
    border: 2px solid var(--ink);
    background: var(--panel);
    box-shadow: 6px 6px 0 var(--ink);
    min-width: 0;
  }
  figcaption {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.45rem 0.8rem;
    border-bottom: 2px solid var(--ink);
    font: 600 0.72rem/1.2 var(--mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  pre {
    margin: 0;
    padding: 1rem 1.1rem 1.2rem;
    overflow-x: auto;
    font: 0.8rem/1.55 var(--mono);
    color: var(--panel-ink);
  }
  pre:focus-visible {
    outline: 3px solid var(--focus);
    outline-offset: -3px;
  }
  .prompt {
    color: var(--muted);
  }
  .cmd {
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    font-weight: 700;
    color: var(--ink);
  }
  .bad {
    color: var(--red);
  }
  .good {
    color: var(--green);
  }
</style>
