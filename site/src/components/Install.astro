---
interface Props {
  version: string;
}

const { version } = Astro.props;
const release = `https://github.com/JarenKempton/interlock/releases/download/v${version}`;
const commands = [
  {
    id: "posix",
    label: "macOS · Linux",
    text: `curl --proto '=https' --tlsv1.2 -fsSL ${release}/install.sh | INTERLOCK_VERSION=${version} sh`,
  },
  {
    id: "windows",
    label: "Windows PowerShell",
    text: `$env:INTERLOCK_VERSION = '${version}'; irm ${release}/install.ps1 | iex`,
  },
];
---

<section class="install" aria-labelledby="install-title">
  <h2 id="install-title">
    Install <span class="tag">v{version}</span>
  </h2>
  {
    commands.map((command) => (
      <div class="command">
        <span class="label" id={`${command.id}-label`}>
          {command.label}
        </span>
        <code id={command.id}>{command.text}</code>
        <button type="button" data-copy={command.id} aria-describedby={`${command.id}-label`}>
          Copy
        </button>
      </div>
    ))
  }
  <p class="fine">
    Checks the SHA-256 of the binary before it replaces anything.
    Installs to <code>~/.local/bin</code> by default; set <code>INTERLOCK_INSTALL_DIR</code> to change it.
  </p>
  <p class="status" role="status" aria-live="polite"></p>
</section>

<script is:inline>
  document.querySelectorAll("[data-copy]").forEach((button) => {
    button.hidden = !navigator.clipboard;
    button.addEventListener("click", async () => {
      const text = document.getElementById(button.dataset.copy).textContent;
      const status = document.querySelector(".install .status");
      try {
        await navigator.clipboard.writeText(text);
        button.textContent = "Copied";
        status.textContent = "Install command copied.";
      } catch {
        button.textContent = "Select";
        status.textContent = "Copy failed. Select the command and copy it by hand.";
      }
      setTimeout(() => {
        button.textContent = "Copy";
      }, 1600);
    });
  });
</script>

<style>
  .install {
    border-top: 2px solid var(--ink);
    padding-top: 1.1rem;
  }
  h2 {
    margin: 0 0 0.8rem;
    font: 700 0.78rem/1 var(--mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .tag {
    margin-left: 0.4rem;
    padding: 0.15rem 0.4rem;
    background: var(--amber-bg);
    color: var(--amber-ink);
    letter-spacing: 0.04em;
  }
  .command {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: stretch;
    margin-bottom: 0.65rem;
    border: 2px solid var(--ink);
    background: var(--panel);
  }
  .label {
    grid-column: 1 / -1;
    padding: 0.3rem 0.7rem;
    border-bottom: 1px dashed var(--rule);
    font: 600 0.68rem/1.2 var(--mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .command code {
    padding: 0.7rem;
    font: 0.78rem/1.5 var(--mono);
    word-break: break-all;
    color: var(--panel-ink);
  }
  button {
    min-width: 5.5rem;
    border: 0;
    border-left: 2px solid var(--ink);
    background: var(--ink);
    color: var(--paper);
    font: 700 0.75rem/1 var(--mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    cursor: pointer;
  }
  button:hover {
    background: var(--blue);
  }
  button:focus-visible {
    outline: 3px solid var(--focus);
    outline-offset: 2px;
  }
  .fine {
    margin: 0.5rem 0 0;
    font-size: 0.85rem;
    color: var(--muted);
  }
  .fine code {
    font: 0.8rem var(--mono);
  }
  @media (max-width: 560px) {
    .command {
      grid-template-columns: minmax(0, 1fr);
    }
    button {
      min-height: 2.75rem;
      border-left: 0;
      border-top: 2px solid var(--ink);
    }
  }
  .status {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
  }
</style>
