---
import { steps, stageCommands } from "../content.ts";
import { LOOP, BOUNDS, holdAt, pct, remap } from "../lib/steps";

interface Props {
  frame?: number;
}

const { frame } = Astro.props;
const live = frame === undefined;

const windows = new Map<string, [number, number]>();
const fmt = (n: number) => String(n).replace(".", "_");
const at2 = (a: number, b = 98) => {
  const name = `iw-${fmt(a)}-${fmt(b)}`;
  windows.set(name, [a, b]);
  return `animation-name:${name}`;
};
const w = (a: number, b = 98) => at2(remap(a), b === 98 ? 98 : remap(b));
const t = (a: number, b?: number) => at2(pct(a), b === undefined ? 98 : pct(b));

const cols = BOUNDS.slice(0, 5).map((a, i) => [pct(a), i === 4 ? 98 : pct(BOUNDS[i + 1]!)] as const);
const P = BOUNDS.map(pct);

function keyframes() {
  const out: string[] = [];
  for (const [name, [a, b]] of windows) {
    const on = "opacity:1;visibility:visible;transform:none";
    const off = "opacity:0;visibility:hidden;transform:translateY(3px)";
    if (a === 0) {
      out.push(`@keyframes ${name}{0%,${b}%{${on}}${b + 0.6}%,99.4%{${off}}100%{${on}}}`);
    } else {
      out.push(`@keyframes ${name}{0%,${a}%{${off}}${a + 0.6}%,${b}%{${on}}${b + 0.6}%,100%{${off}}}`);
    }
  }
  cols.forEach(([a, b], i) => {
    const idle = "border-color:var(--line);background-color:var(--col-bg);box-shadow:none";
    const act = "border-color:var(--accent-line);background-color:var(--col-on);box-shadow:0 0 0 4px var(--accent-tint)";
    const k = a === 0 ? `0%,${b}%{${act}}${b + 0.8}%,99.2%{${idle}}100%{${act}}` : `0%,${a}%{${idle}}${a + 0.8}%,${b}%{${act}}${b + 0.8}%,100%{${idle}}`;
    out.push(`@keyframes icol-${i}{${k}}`);
    const tone = (on: boolean) => (on ? "opacity:1" : "opacity:0.4");
    const dim = a === 0 ? `0%,${b}%{${tone(true)}}${b + 0.8}%,99.2%{${tone(false)}}100%{${tone(true)}}` : `0%,${a}%{${tone(false)}}${a + 0.8}%,${b}%{${tone(true)}}${b + 0.8}%,100%{${tone(false)}}`;
    out.push(`@keyframes idim-${i}{${dim}}`);
    const ink = (on: boolean) => (on ? "color:var(--accent)" : "color:var(--muted)");
    const lbl = a === 0 ? `0%,${b}%{${ink(true)}}${b + 0.8}%,99.2%{${ink(false)}}100%{${ink(true)}}` : `0%,${a}%{${ink(false)}}${a + 0.8}%,${b}%{${ink(true)}}${b + 0.8}%,100%{${ink(false)}}`;
    out.push(`@keyframes ilbl-${i}{${lbl}}`);
  });
  const xs = [11.7, 33.5, 53.3, 72, 90.7];
  const seq = (f: (i: number) => string, last: string) =>
    P.slice(0, 5).map((a, i) => `${i === 0 ? "0%" : `${a + 1}%`},${i === 4 ? 98 : P[i + 1]! - 0.2}%{${f(i)}}`).join("") + last;
  out.push(`@keyframes itoken{${seq((i) => `transform:translateX(${xs[i]}%);opacity:1`, `98.8%{transform:translateX(${xs[4]}%);opacity:0}99.2%{transform:translateX(${xs[0]}%);opacity:0}100%{transform:translateX(${xs[0]}%);opacity:1}`)}}`);
  out.push(`@keyframes irail{${seq((i) => `transform:scaleX(${xs[i]! / 100})`, `99.5%,100%{transform:scaleX(${xs[0]! / 100})}`)}}`);
  out.push(`@keyframes islide{${seq((i) => `transform:translateX(${8 - 87 * i}%)`, `99.5%,100%{transform:translateX(8%)}`)}}`);
  out.push(`@keyframes idraw-a{0%,${P[1]}%{stroke-dashoffset:1}${P[1]! + 2.5}%,98%{stroke-dashoffset:0}99.5%,100%{stroke-dashoffset:1}}`);
  out.push(`@keyframes idraw-b{0%,${P[4]}%{stroke-dashoffset:1}${P[4]! + 2}%,98%{stroke-dashoffset:0}99.5%,100%{stroke-dashoffset:1}}`);
  return out.join("");
}

const bot = `<svg viewBox="0 0 16 16" width="11" height="11"><rect x="2.5" y="4.5" width="11" height="8.5" rx="2.2" fill="none" stroke="currentColor" stroke-width="1.4"/><path d="M8 4.5V2.5" stroke="currentColor" stroke-width="1.4"/><circle cx="6" cy="8.7" r="1.1" fill="currentColor"/><circle cx="10" cy="8.7" r="1.1" fill="currentColor"/></svg>`;
const person = `<svg viewBox="0 0 16 16" width="11" height="11"><circle cx="8" cy="5.6" r="2.6" fill="currentColor"/><path d="M3 14c.6-2.8 2.6-4.3 5-4.3s4.4 1.5 5 4.3" fill="currentColor"/></svg>`;
const lock = `<svg viewBox="0 0 16 16" width="13" height="13"><rect x="3" y="7" width="10" height="7" rx="1.5" fill="none" stroke="currentColor" stroke-width="1.4"/><path d="M5.5 7V5a2.5 2.5 0 0 1 5 0v2" fill="none" stroke="currentColor" stroke-width="1.4"/></svg>`;

const at = live ? 0 : -holdAt(frame ?? 0);
const style = `--at:${at}s;--play:${live ? "running" : "paused"}`;
---

<div class:list={["stage", live ? "live" : "frame"]} id={live ? "stage" : undefined} style={style}>
  {live && (
    <ol class="sr-only">
      {steps.map((s) => <li>{s.title}: {s.caption}</li>)}
      {stageCommands.map((c) => <li>{c.label}: {c.text}</li>)}
    </ol>
  )}
  <div class="canvas" aria-hidden="true">
    <div class="rail">
      <div class="rail-line"><span class="rail-fill"></span></div>
      <div class="token-track"><span class="token">TEST-492</span></div>
    </div>
    <div class="phases">
      {steps.map((s, i) => <span style={`animation-name:ilbl-${i}`}>{s.title}</span>)}
    </div>
    <div class="viewport">
      <div class="track">
        <section class="col" style="animation-name:icol-0">
          <header><span class="ttl">{steps[0].title}</span></header>
          <ul class="queue">
            <li class="ticket"><span class="key">TEST-491</span><span class="tt">Fix the export date</span></li>
            <li class="ticket">
              <span class="sel" style={t(0.8)}></span>
              <span class="key">TEST-492</span>
              <span class="tt">Prepare a real pickup</span>
              <span class="owner" style={t(1.5)}><span class="acc" set:html={lock} /><span class="av sm you">Y</span></span>
            </li>
            <li class="ticket"><span class="key">TEST-493</span><span class="tt">Add a CSV download</span></li>
          </ul>
        </section>

        <section class="col" style="animation-name:icol-1">
          <header><span class="ttl">{steps[1].title}</span></header>
          <svg class="graph" viewBox="0 0 240 112" style={t(3.6)}>
            <line x1="8" y1="88" x2="232" y2="88" class="main"></line>
            <circle cx="24" cy="88" r="4" class="c-main"></circle>
            <text x="8" y="106" class="lbl">main</text>
            <g style={t(3.8, 18.3)}>
              <path d="M40 88 C 56 88 56 40 76 40 L 196 40" pathLength="1" class="branch" style="animation-name:idraw-a"></path>
              <circle cx="40" cy="88" r="4" class="c-main"></circle>
              <text x="80" y="28" class="lbl acc">task/TEST-492</text>
              <circle cx="104" cy="40" r="4.5" class="c-br" style={t(6.8, 18.3)}></circle>
              <circle cx="136" cy="40" r="4.5" class="c-br" style={t(8.6, 18.3)}></circle>
              <circle cx="168" cy="40" r="4.5" class="c-br" style={t(13, 18.3)}></circle>
              <path d="M196 40 C 214 40 210 88 222 88" pathLength="1" class="branch" style="animation-name:idraw-b"></path>
            </g>
            <circle cx="222" cy="88" r="5" class="c-merge" style={w(83)}></circle>
          </svg>
          <ul class="checks prep">
            <li style={t(3.9)}><span class="ck">✓</span>Branch created</li>
            <li style={t(4.4)}><span class="ck">✓</span>Worktree created</li>
            <li style={t(4.9)}><span class="ck">✓</span>Startup script ran</li>
          </ul>
        </section>

        <section class="col" style="animation-name:icol-2">
          <header><span class="ttl">{steps[2].title}</span></header>
          <div class="box lane" style={t(5.6)}>
            <div class="lane-head">
              <span class="key">TEST-492</span>
              <span class="agt"><span class="ring" style={t(5.8, 9.4)}></span><span class="av sm bot" set:html={bot} /></span>
            </div>
            <div class="code">
              <span class="ln"><i style="width:42%"></i></span>
              <span class="ln add" style={t(6.4)}><i style="width:68%"></i></span>
              <span class="ln add" style={t(7.2)}><i style="width:55%"></i></span>
              <span class="ln"><i style="width:30%"></i></span>
              <span class="ln add" style={t(8)}><i style="width:61%"></i></span>
              <span class="ln add" style={t(8.7)}><i style="width:74%"></i></span>
            </div>
          </div>
        </section>

        <section class="col" style="animation-name:icol-3">
          <header><span class="ttl">{steps[3].title}</span></header>
          <div class="box pr" style={t(10.3)}>
            <div class="pr-head">
              <svg viewBox="0 0 16 16" width="14" height="14"><circle cx="4" cy="3.5" r="1.8" fill="none" stroke="currentColor" stroke-width="1.3"></circle><circle cx="4" cy="12.5" r="1.8" fill="none" stroke="currentColor" stroke-width="1.3"></circle><circle cx="12" cy="12.5" r="1.8" fill="none" stroke="currentColor" stroke-width="1.3"></circle><path d="M4 5.3v5.4M12 10.7V6.5A2 2 0 0 0 10 4.5H7.5" fill="none" stroke="currentColor" stroke-width="1.3"></path></svg>
              <span class="prn">#1</span>
              <span class="swap end">
                <span class="pill acc" style={t(10.3, 11.8)}>open</span>
                <span class="pill no" style={t(11.8, 14)}>changes</span>
                <span class="pill ok" style={t(14, 16.2)}>approved</span>
                <span class="pill ok" style={t(16.2)}>merged</span>
              </span>
            </div>
            <span class="tt">TEST-492: Prepare a real pickup</span>
            <ul class="thread">
              <li style={t(11.8)}><span class="av sm rv" set:html={person} /><span class="ic"><svg viewBox="0 0 16 16" width="13" height="13"><path d="M3 3.5h10a1 1 0 0 1 1 1v6a1 1 0 0 1-1 1H7l-3 2.5V11.5H3a1 1 0 0 1-1-1v-6a1 1 0 0 1 1-1Z" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"></path></svg></span><span class="cbar"><i style="width:70%"></i></span><span class="swap end"><span class="mark no" style={t(11.8, 13.4)}>●</span><span class="mark ok" style={t(13.4)}>✓</span></span></li>
              <li style={t(12.6)}><span class="av sm bot" set:html={bot} /><span class="commits"><i></i><i style={t(13)}></i></span></li>
              <li style={t(14)}><span class="av sm rv" set:html={person} /><span class="pill ok end">✓</span></li>
            </ul>
          </div>
        </section>

        <section class="col" style="animation-name:icol-4">
          <header><span class="ttl">{steps[4].title}</span></header>
          <div class="merge" style={t(16.3)}><span class="av sm you">Y</span><span class="prn">#1</span><span class="pill ok">merged</span></div>
          <ul class="checks">
            <li style={w(84)}><span class="ck">✓</span>Done</li>
            <li style={w(90)}><span class="ck">✓</span>Worktree removed</li>
            <li style={w(93)}><span class="ck">✓</span>Branch removed</li>
          </ul>
        </section>
      </div>
    </div>
    <div class="commands">
      {stageCommands.map((c) => (
        <div class="command" style={t(c.from, c.to)}>
          <span class="prompt">$</span><code>{c.text}</code>
        </div>
      ))}
    </div>
  </div>

  {live && <style is:inline set:html={keyframes()} />}
</div>

<style>
  .stage {
    --ease: cubic-bezier(0.65, 0, 0.35, 1);
    --tcols: minmax(0, 1.25fr) minmax(0, 1.1fr) repeat(3, minmax(0, 1fr));
    position: relative;
  }
  .stage :is(.col, [style*="animation-name"], .token-track, .rail-fill, .track, .branch) {
    animation-duration: 20s;
    animation-iteration-count: infinite;
    animation-timing-function: var(--ease);
    animation-fill-mode: both;
    animation-delay: var(--at);
    animation-play-state: var(--play);
  }

  .canvas {
    position: relative;
    text-align: left;
    padding: 1.5rem clamp(1rem, 2.4vw, 2rem) 0;
  }
  .rail {
    position: relative;
    height: 2.25rem;
    margin-bottom: 0.75rem;
  }
  .rail-line {
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    height: 1px;
    background: var(--line-2);
  }
  .rail-fill {
    position: absolute;
    inset: 0;
    background: var(--accent);
    transform-origin: left;
    animation-name: irail;
  }
  .token-track {
    position: absolute;
    inset: 0;
    animation-name: itoken;
  }
  .token {
    position: absolute;
    left: 0;
    top: 50%;
    transform: translate(-50%, -50%);
    padding: 0.3rem 0.6rem;
    border: 1px solid var(--accent-line);
    border-radius: 999px;
    background: var(--bg);
    color: var(--accent);
    font: 600 0.6875rem/1 var(--mono);
    letter-spacing: 0.04em;
    box-shadow: 0 0 0 4px var(--bg), 0 0 24px var(--accent-tint);
    white-space: nowrap;
  }

  .viewport {
    overflow: hidden;
    margin: -6px;
    padding: 6px;
  }
  .track {
    display: grid;
    grid-template-columns: var(--tcols);
    gap: 0.75rem;
  }
  .col {
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
    min-height: 23rem;
    padding: 1.1rem;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--col-bg);
  }
  .col header {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.35rem 0.55rem;
    padding-bottom: 0.7rem;
    margin-bottom: 0.15rem;
    border-bottom: 1px solid var(--line);
  }
  .ttl {
    font-weight: 600;
    font-size: 1.125rem;
    letter-spacing: -0.01em;
    color: var(--fg);
  }

  .av {
    display: inline-grid;
    place-items: center;
    width: 1.375rem;
    height: 1.375rem;
    border-radius: 50%;
    font: 600 0.6875rem/1 var(--sans);
    flex: none;
  }
  .av.sm {
    width: 1.125rem;
    height: 1.125rem;
    font-size: 0.625rem;
  }
  .av.you {
    background: var(--accent);
    color: var(--accent-ink);
  }
  .av.bot {
    border-radius: 4px;
    background: color-mix(in oklab, var(--fg) 12%, transparent);
    color: var(--fg);
  }

  .key {
    font: 600 0.8125rem/1.4 var(--mono);
    color: var(--fg);
  }
  .tt {
    font-size: 0.875rem;
    color: var(--fg-2);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .swap {
    display: inline-grid;
    justify-items: start;
    align-items: center;
  }
  .swap > * {
    grid-area: 1 / 1;
  }
  .swap.end {
    justify-items: end;
    margin-left: auto;
  }

  .pill {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.2rem 0.45rem;
    border: 1px solid var(--line-2);
    border-radius: 5px;
    font: 500 0.75rem/1.2 var(--mono);
    color: var(--fg-2);
    white-space: nowrap;
  }
  .pill.acc {
    color: var(--accent);
    border-color: var(--accent-line);
    background: var(--accent-tint);
  }
  .pill.ok {
    color: var(--ok);
    border-color: color-mix(in oklab, var(--ok) 45%, transparent);
    background: color-mix(in oklab, var(--ok) 9%, transparent);
  }
  .pill.no {
    color: var(--no);
    border-color: color-mix(in oklab, var(--no) 45%, transparent);
    background: color-mix(in oklab, var(--no) 9%, transparent);
  }

  .checks {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .box {
    position: relative;
    padding: 0.65rem;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--bg-2);
  }
  .graph {
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .graph .main {
    stroke: var(--line-2);
    stroke-width: 2;
  }
  .branch {
    fill: none;
    stroke: var(--accent);
    stroke-width: 2;
    stroke-dasharray: 1;
  }
  .branch[style*="idraw-a"] {
    animation-name: idraw-a;
  }
  .c-main {
    fill: var(--bg);
    stroke: var(--muted);
    stroke-width: 2;
  }
  .c-br {
    fill: var(--accent);
    stroke: var(--bg);
    stroke-width: 2;
  }
  .c-merge {
    fill: var(--ok);
    stroke: var(--bg);
    stroke-width: 2;
  }
  .lbl {
    font: 500 12px var(--mono);
    fill: var(--muted);
  }
  .lbl.acc {
    fill: var(--accent);
  }
  .checks code {
    font: 500 0.8125rem/1.2 var(--mono);
    color: var(--fg);
  }

  .lane {
    display: grid;
    gap: 0.5rem;
  }
  .lane-head {
    gap: 0.5rem;
    white-space: nowrap;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--line);
  }
  .acc {
    color: var(--accent);
  }
  .ok {
    color: var(--ok);
  }

  .pr-head {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    margin-bottom: 0.4rem;
    color: var(--ok);
  }
  .prn {
    font: 600 0.8125rem/1 var(--mono);
    color: var(--fg);
  }
  .pr .tt {
    display: block;
  }

  .checks {
    display: grid;
    gap: 0.35rem;
  }
  .checks li {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.5rem 0.6rem;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--bg-2);
    font-size: 0.9375rem;
    color: var(--fg);
  }
  .ck {
    display: inline-grid;
    place-items: center;
    width: 1.1rem;
    height: 1.1rem;
    border-radius: 50%;
    background: color-mix(in oklab, var(--ok) 16%, transparent);
    color: var(--ok);
    font-size: 0.6875rem;
    font-weight: 700;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  .code {
    display: grid;
    gap: 0.55rem;
    padding-top: 0.25rem;
  }
  .ln {
    display: block;
    height: 0.5rem;
  }
  .ln i {
    display: block;
    height: 100%;
    border-radius: 3px;
    background: color-mix(in oklab, var(--fg) 14%, transparent);
  }
  .ln.add i {
    background: color-mix(in oklab, var(--ok) 45%, transparent);
  }
  .agt {
    display: inline-grid;
    place-items: center;
  }
  .agt > * {
    grid-area: 1 / 1;
  }
  .ring {
    display: block;
    width: calc(100% + 6px);
    height: calc(100% + 6px);
    border-radius: 6px;
    box-shadow: 0 0 0 2px var(--accent), 0 0 0 6px var(--accent-tint);
  }
  .mark {
    display: inline-grid;
    place-items: center;
    width: 0.95rem;
    height: 0.95rem;
    border-radius: 50%;
    font-size: 0.5625rem;
    font-weight: 700;
    font-style: normal;
  }
  .mark.ok {
    background: color-mix(in oklab, var(--ok) 18%, var(--bg));
    color: var(--ok);
  }
  .mark.no {
    background: color-mix(in oklab, var(--no) 16%, var(--bg));
    color: var(--no);
  }
  .thread {
    display: grid;
    gap: 0.5rem;
    margin: 0.7rem 0 0;
    padding: 0.6rem 0 0;
    border-top: 1px solid var(--line);
    list-style: none;
  }
  .thread li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 1.5rem;
  }
  .ic {
    display: inline-flex;
    color: var(--muted);
  }
  .cbar {
    flex: 1;
    height: 0.45rem;
  }
  .cbar i {
    display: block;
    height: 100%;
    border-radius: 3px;
    background: color-mix(in oklab, var(--fg) 14%, transparent);
  }
  .commits {
    display: inline-flex;
    gap: 0.35rem;
  }
  .commits i {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: var(--accent);
  }
  .merge {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.6rem;
  }
  .merge .pill {
    margin-left: auto;
  }
  .pill.end {
    margin-left: auto;
  }
  .queue {
    display: grid;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .ticket {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 2.75rem;
    padding: 0 0.7rem;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--bg-2);
  }
  .ticket .tt {
