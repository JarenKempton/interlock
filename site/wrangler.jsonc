{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "interlock-site",
  "compatibility_date": "2026-10-01",
  "send_metrics": false,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "routes": [{ "pattern": "interlock.build", "custom_domain": true }]
}
